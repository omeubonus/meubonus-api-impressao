{
  "name": "@silentprint/desktop",
  "version": "1.1.0",
  "description": "SilentPrint Desktop Local Agent",
  "main": "dist/main/index.js",
  "type": "commonjs",
  "scripts": {
    "dev": "vite",
    "build:main": "vite build --config vite.main.config.ts --mode production",
    "build:preload": "vite build --config vite.preload.config.ts --mode production",
    "build:renderer": "vite build --config vite.renderer.config.ts --mode production",
    "build:main:dev": "vite build --config vite.main.config.ts --mode development",
    "build:preload:dev": "vite build --config vite.preload.config.ts --mode development",
    "build:renderer:dev": "vite build --config vite.renderer.config.ts --mode development",
    "build": "tsc --noEmit && npm run build:main && npm run build:preload && npm run build:renderer",
    "build:dev": "tsc --noEmit && npm run build:main:dev && npm run build:preload:dev && npm run build:renderer:dev",
    "start": "electron .",
    "dist": "npm run build && electron-builder",
    "dist:dev": "npm run build:dev && electron-builder -c.mac.icon=build/icon-dev.icns -c.win.icon=build/icon-dev.ico -c.productName=\"SilentPrint Agent Dev\" -c.appId=\"com.silentprint.desktop.dev\""
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.9",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "socket.io-client": "^4.8.1",
    "tailwind-merge": "^3.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.2",
    "vite": "^6.2.0"
  }
}
